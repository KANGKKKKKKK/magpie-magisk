#!/system/bin/sh
# magpie 服务控制: magpie.service {start|stop|restart|status}

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"
# 调用者（看门狗、磁贴 App 的 su、管理器）的 umask 可能是 0000；
# 这里新建的日志、锁、PID 与 DNS 文件都只该给 root 读写。
umask 077

# 读配置；文件缺失时用内置默认值
CONF="${MAGPIE_CONF:-/data/adb/magpie/scripts/magpie.config}"
[ -f "$CONF" ] || CONF="$(dirname "$0")/magpie.config"
# 语法错误的配置不 source：BusyBox ash 会因此整个退出（见 lib.sh magpie_conf_syntax_ok）
if [ -f "$CONF" ] && ! sh -n "$CONF" >/dev/null 2>&1; then
  echo "! 配置文件有语法错误，已改用默认值：$CONF" >&2
  MAGPIE_CONF_ERROR="配置文件有语法错误（$CONF），已按默认值运行"
else
  [ -f "$CONF" ] && . "$CONF" 2>/dev/null
fi

magpie_path=${magpie_path:-/data/adb/magpie}
MAGPIE_ADDR=${MAGPIE_ADDR:-127.0.0.1:3425}
MAGPIE_DNS=${MAGPIE_DNS:-"223.5.5.5 119.29.29.29 8.8.8.8"}

BIN="$magpie_path/bin/magpie"
RUN="$magpie_path/run"
PIDFILE="$RUN/magpie.pid"
LOG="$RUN/magpie.log"

# 局域网地址规则与 status.sh / action.sh / doctor.sh 共用同一份实现。
# 必须在算端口之前 source：下面要用 addr_port / addr_host / is_loopback_host。
_NETLIB="$(dirname "$0")/lib.sh"
if [ -f "$_NETLIB" ]; then
  . "$_NETLIB"
else
  lan_ip() { return 1; }
  addr_host() { case "$1" in \[*\]:*) _h=${1#\[}; echo "${_h%%\]*}" ;; *:*) echo "${1%:*}" ;; *) echo "$1" ;; esac; }
  addr_port() { case "$1" in \[*\]:*) _p=${1##*\]:} ;; *:*) _p=${1##*:} ;; *) return 1 ;; esac; case "$_p" in ''|*[!0-9]*) return 1 ;; esac; echo "$_p"; }
  is_loopback_host() { _h=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); case "$_h" in 127.*|localhost|::1|\[::1\]|::ffff:127.*) return 0 ;; esac; return 1; }
  # lib.sh 缺失时也要能生成出东西，但**不做半套校验**：
  # 一个看起来做了校验、实际漏判的实现，比明说「没校验」更容易骗过人。
  # 真正的过滤在 lib.sh 里，这里只保证「非空项原样写出去」，
  # 有效性仍由 sync_resolv_conf 最后的 `grep '^nameserver '` 兜底。
  magpie_resolv_body() {
    for _ns in $1; do
      [ -n "$_ns" ] || continue
      echo "nameserver $_ns"
    done
    echo "options timeout:2 attempts:2"
  }
  magpie_bad_dns() { return 0; }
fi

WEB_HOST=${MAGPIE_WEB_ADDR:-"${MAGPIE_ADDR%:*}:3430"}

# 端口必须能解析出来：写成 127.0.0.1（漏端口）时不让它启动。
# 静默用默认端口跑起来，用户只会看到「已启动」然后连不上，更难查。
API_PORT=$(addr_port "$MAGPIE_ADDR" 2>/dev/null)
WEB_PORT=$(addr_port "$WEB_HOST" 2>/dev/null)
ADDR_ERROR=""
if [ -z "$API_PORT" ]; then
  ADDR_ERROR="MAGPIE_ADDR=$MAGPIE_ADDR 的端口不可用（应为 主机:端口，1-65535；IPv6 用 [::1]:3425）"
elif [ -z "$WEB_PORT" ]; then
  ADDR_ERROR="面板监听地址 $WEB_HOST 的端口不可用（MAGPIE_WEB_ADDR 应为 主机:端口）"
elif [ "$API_PORT" = "$WEB_PORT" ]; then
  # 两个监听抢同一个端口，serve 一启动就退出；以前会被看门狗每 30 秒拉一次。
  ADDR_ERROR="网关与面板用了同一个端口 $API_PORT（MAGPIE_ADDR 与 MAGPIE_WEB_ADDR 必须不同）"
fi

WEB_KEY_FILE="$magpie_path/data/web.key"

# 仅在持有启停锁的 start 内调用；必须锁内重读，两个首次 start 才不会各自
# 生成密钥后互相覆盖。status 连目录、权限和 pidfile 都不应改动。
ensure_web_key() {
  mkdir -p "$magpie_path/data" || return 1
  if [ -s "$WEB_KEY_FILE" ]; then
    WEB_KEY=$(cat "$WEB_KEY_FILE" 2>/dev/null) || return 1
    [ -n "$WEB_KEY" ] && chmod 600 "$WEB_KEY_FILE" 2>/dev/null || return 1
  else
    WEB_KEY=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 32)
    _web_key_tmp="$magpie_path/data/.web.key.$$"
    if [ "${#WEB_KEY}" -ne 32 ] ||
       ! ( umask 077; printf '%s\n' "$WEB_KEY" > "$_web_key_tmp" ) 2>/dev/null ||
       ! chmod 600 "$_web_key_tmp" 2>/dev/null ||
       ! mv -f "$_web_key_tmp" "$WEB_KEY_FILE" 2>/dev/null; then
      rm -f "$_web_key_tmp" 2>/dev/null
      return 1
    fi
  fi
}

# 带日期，跨天也能对上时间线
log() { echo "$(date +'%Y-%m-%d %H:%M:%S') [$1] $2"; }

LOG_MAX_BYTES=5242880

# 超过 5MB 归档为 .1，必须在进程打开日志 fd 之前调用。
# 实现在 lib.sh（service.sh 共用同一份），这里只补说明行。
# lib.sh 缺失时不轮转、也不每轮喊一次：那种状态下日志变大不是最要紧的问题，
# 刷屏反而会把它盖住。只在真的超了阈值时提一句。
rotate_log() {
  _f="$1"
  _sz=$(stat -c %s "$_f" 2>/dev/null)
  [ -n "$_sz" ] && [ "$_sz" -gt "$LOG_MAX_BYTES" ] 2>/dev/null || return 0
  if command -v magpie_rotate_log >/dev/null 2>&1; then
    magpie_rotate_log "$_f" "$LOG_MAX_BYTES"
  else
    log Warn "lib.sh 缺失, 日志轮转跳过（${_f##*/} 已超 5MB）"
    return 0
  fi
  log Info "日志超 5MB, 已归档为 ${_f##*/}.1"
}

clean_logs() { rotate_log "$LOG"; }

# DNS：magpie 本体是不链接 libc 的 Go 静态 PIE，cgo 解析器不可用，只能走纯 Go 解析器。
# 纯 Go 解析器只认 /etc/resolv.conf；Android 没有这个文件，读不到就退回
# 127.0.0.1:53 / [::1]:53（那里没人监听），于是原生通道全部 connection refused。
# 所以模块自带 system/etc/resolv.conf，由 Magisk 覆盖到 /etc/resolv.conf；
# 下面 sync_resolv_conf 按 MAGPIE_DNS 重写那份覆盖文件。
# 注意 Go 标准库并没有 DNS_LOCAL_HOSTNAMES 这个变量（本体里也搜不到），
# v0.9.0 及以前注入的 export 从来没生效过。
DNS_SERVERS="$MAGPIE_DNS"
RESOLV_CONF="$RUN/resolv.conf"
USER_STOPPED="$RUN/.user_stopped"
INTENT_LOCK="$RUN/.stop-intent.flock"
# 与旧目录锁分开；旧 .service.lock 仅为遗留诊断元信息，不读取或回收。
SERVICE_LOCK="$RUN/.service.flock"

# 内核锁不依赖 owner/PID，也没有 mkdir -> HELD 的半初始化窗口。
# 9 号 FD 在打开前已经有 EXIT trap 兜底，释放时无条件 unlock + close。
acquire_service_lock() {
  if ! command -v magpie_pick_flock >/dev/null 2>&1 || ! magpie_pick_flock; then
    log Error "缺少可用的 flock，拒绝不安全地执行启停（请恢复 Root BusyBox / lib.sh）"
    return 1
  fi
  if [ -L "$RUN" ] || [ -L "$SERVICE_LOCK" ] ||
     { [ -e "$SERVICE_LOCK" ] && [ ! -f "$SERVICE_LOCK" ]; }; then
    log Error "启停锁路径不是普通文件或是符号链接：$SERVICE_LOCK"
    return 1
  fi
  exec 9>>"$SERVICE_LOCK"
  # 拒绝检查与 open 之间被换掉的路径；父目录须为可信的私有目录。
  # shellcheck disable=SC3013  # Android ash/mksh 与 Linux dash 均支持 inode 比较
  if [ -L "$SERVICE_LOCK" ] || [ ! "$SERVICE_LOCK" -ef /proc/self/fd/9 ]; then
    log Error "启停锁路径已改变：$SERVICE_LOCK"
    return 1
  fi
  _lock_i=0
  until magpie_flock -n 9; do
    [ "$_lock_i" -lt 150 ] || { log Error "另一个启停操作仍在进行，或内核 flock 不可用，请稍后重试"; return 1; }
    sleep 0.1; _lock_i=$((_lock_i + 1))
  done
}
release_service_lock() {
  # 即使信号落在 open/flock 与下一条 shell 语句之间，也不能漏掉 FD。
  magpie_flock -u 9 2>/dev/null || :
  exec 9>&-
}
has_stop_request() {
  for _r in "$RUN"/.stop-request.*; do
    [ -e "$_r" ] || continue
    _rp=${_r##*.}
    case "$_rp" in ''|*[!0-9]*) continue ;; esac
    if kill -0 "$_rp" 2>/dev/null; then return 0; fi
    rm -f "$_r" 2>/dev/null
  done
  return 1
}
# 单独的短锁串行化用户停止意图与显式启动清除。它不随服务生命周期持有，
# 绝不拿着它等 FD 9：stop 在等主锁前就能发布意图。子 shell 自动关闭 FD 6。
with_stop_intent_lock() (
  magpie_pick_flock || exit 1
  if [ -L "$INTENT_LOCK" ] || { [ -e "$INTENT_LOCK" ] && [ ! -f "$INTENT_LOCK" ]; }; then exit 1; fi
  exec 6>>"$INTENT_LOCK"
  # shellcheck disable=SC3013  # Android ash/mksh 与 Linux dash 均支持 inode 比较
  [ ! -L "$INTENT_LOCK" ] && [ "$INTENT_LOCK" -ef /proc/self/fd/6 ] || exit 1
  _intent_wait=0
  until magpie_flock -n 6; do
    [ "$_intent_wait" -lt 50 ] || exit 1
    sleep 0.02
    _intent_wait=$((_intent_wait + 1))
  done
  "$@"
)

write_stop_intent() {
  _intent_boot=$(magpie_boot_id) || _intent_boot=unknown
  _intent_tmp=$(mktemp "$RUN/.stop-intent.XXXXXX") || return 1
  if ! printf 'boot=%s\n' "$_intent_boot" > "$_intent_tmp" || ! mv -f "$_intent_tmp" "$USER_STOPPED"; then
    rm -f "$_intent_tmp" 2>/dev/null
    return 1
  fi
}

clear_manual_stop_intent() {
  has_stop_request && return 2
  rm -f "$USER_STOPPED"
}

begin_stop_request() {
  # 只属于当前命令；EXIT trap 会回收，自动启动绝不能删掉仍有效的请求。
  STOP_REQUEST_FILE="$RUN/.stop-request.$$"
  (umask 077; set -C; : > "$STOP_REQUEST_FILE") 2>/dev/null || {
    STOP_REQUEST_FILE=''
    log Error "无法发布停止请求"
    return 1
  }
}

end_stop_request() {
  [ -z "$STOP_REQUEST_FILE" ] || rm -f "$STOP_REQUEST_FILE" 2>/dev/null || return 1
  STOP_REQUEST_FILE=''
}

CA_BUNDLE="$magpie_path/data/certs/ca-bundle.crt"
CA_STAMP="$CA_BUNDLE.stamp"

# 模块目录：DNS 覆盖文件写在这里。脚本被软链调用时 $0 可能是别的路径，兜底到默认位置。
MODDIR=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)
[ -n "$MODDIR" ] || MODDIR=/data/adb/modules/magpie
RESOLV_OVERLAY="$MODDIR/system/etc/resolv.conf"

# 把 run/lan.url 刷成当前地址；没有可用地址就删掉它。
# 返回 0 表示内容有变化（调用方据此决定要不要刷新状态）。
refresh_lan_url() {
  _new=$(lan_ip)
  _old=$(cat "$RUN/lan.url" 2>/dev/null)
  _old=$(echo "$_old" | sed -n 's#^http://\([^:]*\):.*#\1#p')
  if [ "$_new" = "$_old" ]; then
    return 1
  fi
  if [ -n "$_new" ]; then
    echo "http://$_new:$WEB_PORT" > "$RUN/lan.url" 2>/dev/null
    log Info "局域网地址更新为 http://$_new:$WEB_PORT"
  else
    rm -f "$RUN/lan.url" 2>/dev/null
    log Info "当前没有可用的局域网地址, 已清除对外地址"
  fi
  return 0
}

# 进程防杀：root 起的进程默认已是 -1000，这里只做校验，
# 若被外部改过（某些省电模块会重设）就改回来。
pin_oom() {
  _p="$1"
  [ -n "$_p" ] && [ -d "/proc/$_p" ] || return 1
  _cur=$(cat "/proc/$_p/oom_score_adj" 2>/dev/null)
  [ "$_cur" = "-1000" ] && return 0
  if echo -1000 > "/proc/$_p/oom_score_adj" 2>/dev/null; then
    log Info "oom_score_adj $_cur -> -1000"
  else
    log Warn "无法设置 oom_score_adj (当前 $_cur)"
  fi
}


running() {
  # 只认 serve 主进程。MCP 子进程（magpie mcp vision/search/image）也叫 magpie，
  # 用 pidof | head -1 会取到它们，导致判断错误、stop 杀错进程。
  # 探测本身只读；pidfile 的维护由持锁的 start/stop 负责。
  magpie_main_pid
}

# 与只读探测共用 lib.sh 的精确 argv / 本体身份判断，不再比较「第一个」PID：
# 同时残留多个 serve 时，每一个合法候选都必须能停止。
service_pid_command() {
  magpie_pid_command "$1" "$2" "$BIN"
}

service_pid_matches() {
  service_pid_command "$1" "$2"
}

stop_magpie_pid() {
  # 候选已退出或换身份只跳过，绝不能因为快照过期去杀普通 CLI。
  service_pid_matches "$1" "$2" || return 0
  kill -15 "$1" 2>/dev/null || return 1
  _stop_i=0
  while kill -0 "$1" 2>/dev/null && [ "$_stop_i" -lt "$3" ]; do
    sleep 0.1; _stop_i=$((_stop_i + 1))
  done
  # 等待中可能退出并复用 PID；KILL 前必须重新核对身份。
  if service_pid_matches "$1" "$2"; then
    kill -9 "$1" 2>/dev/null || return 1
    # 信号发送成功不等于已经退出；给内核有限时间，再核实真正后置状态。
    _stop_i=0
    while service_pid_matches "$1" "$2" && [ "$_stop_i" -lt 10 ]; do
      sleep 0.1; _stop_i=$((_stop_i + 1))
    done
    service_pid_matches "$1" "$2" && return 1
  fi
  return 0
}

# v0.2 的兼容清理只处理 run 里有记录且仍能核验的实例。仅监听 ::1 不是所有权证明。
# 无记录、PID 已复用或归属不明时不发信号；不再遍历系统全部 dnsmasq / sleep。
legacy_pid_matches() (
  case "$1" in ''|0|1|*[!0-9]*) exit 1 ;; esac
  _exe=$(readlink "/proc/$1/exe" 2>/dev/null) || exit 1
  _args=$(tr '\000\n' '\n\001' 2>/dev/null < "/proc/$1/cmdline") || exit 1
  case "$2:${_exe##*/}" in
    dnsmasq:dnsmasq)
      # 旧版可能让 dnsmasq 自写 pidfile，或用模块的 FIFO 作为 stdin。
      printf '%s\n' "$_args" | grep -Fxq -- '--listen-address=::1' || exit 1
      printf '%s\n' "$_args" | grep -Fxq -- "--pid-file=$RUN/dnsmasq.pid" && exit 0 ;;
    keep:sleep|keep:toybox|keep:busybox)
      case "$_args" in 'sleep
2147483647'|*/'sleep
2147483647') ;; *) exit 1 ;; esac ;;
    *) exit 1 ;;
  esac
  for _fd in /proc/"$1"/fd/*; do
    case "$(readlink "$_fd" 2>/dev/null)" in "$RUN/dnsmasq.fifo"|"$RUN/dnsmasq.fifo (deleted)") exit 0 ;; esac
  done
  exit 1
)

cleanup_legacy_dnsmasq() {
  for _legacy in dnsmasq keep; do
    case "$_legacy" in dnsmasq) _file="$RUN/dnsmasq.pid" ;; keep) _file="$RUN/dnsmasq.keep.pid" ;; esac
    if [ ! -f "$_file" ] || [ -L "$_file" ]; then continue; fi
    _lp=$(cat "$_file" 2>/dev/null)
    if legacy_pid_matches "$_lp" "$_legacy"; then
      kill -TERM "$_lp" 2>/dev/null || continue
      _n=0
      while [ "$_n" -lt 20 ] && legacy_pid_matches "$_lp" "$_legacy"; do
        sleep 0.1; _n=$((_n + 1))
      done
      if legacy_pid_matches "$_lp" "$_legacy"; then kill -KILL "$_lp" 2>/dev/null || continue; fi
    fi
    rm -f "$_file" 2>/dev/null
  done
  rm -f "$RUN/dnsmasq.fifo" "$RUN/dnsmasq.log" 2>/dev/null
  return 0
}

# 系统证书目录指纹：文件数 + 目录 mtime。
# 装/卸根证书模块、系统升级换了 CA 库，指纹都会变，下次启动自动重建。
# 实现在 lib.sh（magpie-cli.sh 共用同一份）。不在这里留第二份实现：
# 两份指纹算法一旦漂移，会出现「证书明明变了却不重建」这种极难查的问题。
ca_fingerprint() {
  if command -v magpie_ca_fingerprint >/dev/null 2>&1; then
    magpie_ca_fingerprint
    return 0
  fi
  echo "lib.sh-missing"
}

# Go 找不到 Android 证书库，合并系统证书交给 SSL_CERT_FILE。
# 合并本身在 lib.sh（magpie-cli.sh 共用同一份），这里负责指纹比对、写 stamp 与措辞。
# 指纹只取一次：以前是「比对时算一次、写 stamp 时再算一次」，
# 两次之间目录 mtime 变了就会写进一个永远匹配不上的 stamp，下次启动白重建一遍。
ensure_ca_bundle() {
  _fp=$(ca_fingerprint)
  if [ -s "$CA_BUNDLE" ] && [ "$(cat "$CA_STAMP" 2>/dev/null)" = "$_fp" ]; then
    return 0
  fi

  if ! command -v magpie_write_ca_bundle >/dev/null 2>&1; then
    log Error "lib.sh 缺失, 无法生成 CA 证书包（HTTPS 请求会失败）"
    [ -s "$CA_BUNDLE" ] && return 0
    return 1
  fi

  if _n=$(magpie_write_ca_bundle "$CA_BUNDLE" 2>/dev/null); then
    echo "$_fp" > "$CA_STAMP" 2>/dev/null
    log Info "已生成 CA 证书包 ($_n 张)"
    return 0
  fi

  [ -s "$CA_BUNDLE" ] && { log Warn "CA 证书包重建失败, 继续用旧包"; return 0; }
  log Warn "无法生成 CA 证书包, HTTPS 请求可能失败"
  return 1
}

# 按 MAGPIE_DNS 生成 DNS 配置，写到两处：
#   $RUN/resolv.conf                     本机参照，也方便 user 直接 cat
#   $MODDIR/system/etc/resolv.conf       Magisk 覆盖，开机后就是 /etc/resolv.conf
# 覆盖文件是 magpie 唯一的上游来源，所以这里失败就等于原生通道全废，要出声。
sync_resolv_conf() {
  # 逐条点名被跳过的项：只写「格式不对」，用户不知道是哪一条，
  # 也容易误以为整份配置都没生效（实际是其余项照常写入了）。
  _bad=$(magpie_bad_dns "$DNS_SERVERS" 2>/dev/null | tr '\n' ' ')
  [ -n "$_bad" ] && log Warn "MAGPIE_DNS 里这些项不是合法地址, 已跳过: $_bad"

  magpie_resolv_body "$DNS_SERVERS" > "$RESOLV_CONF.tmp" 2>/dev/null
  # 没有一条 nameserver 就用不了（Go 会退回 127.0.0.1:53），宁可保留旧的
  if [ ! -s "$RESOLV_CONF.tmp" ] || ! grep -q '^nameserver ' "$RESOLV_CONF.tmp" 2>/dev/null; then
    rm -f "$RESOLV_CONF.tmp" 2>/dev/null
    log Warn "MAGPIE_DNS 里没有一条可用地址, 保留现有 DNS 配置"
    return 1
  fi
  chmod 644 "$RESOLV_CONF.tmp" 2>/dev/null
  mv -f "$RESOLV_CONF.tmp" "$RESOLV_CONF" 2>/dev/null

  # 只有真模块目录才写覆盖：测试沙箱里 MODDIR 指向临时目录，
  # 不挡一下会在那里凭空造出一个 system/etc/ 来。
  if [ -f "$MODDIR/module.prop" ]; then
    mkdir -p "$MODDIR/system/etc" 2>/dev/null
    if ! cmp -s "$RESOLV_CONF" "$RESOLV_OVERLAY" 2>/dev/null; then
      cp -f "$RESOLV_CONF" "$RESOLV_OVERLAY" 2>/dev/null && chmod 644 "$RESOLV_OVERLAY" 2>/dev/null
    fi
  fi

  _want=$(sed -n 's/^nameserver[[:space:]]*//p' "$RESOLV_CONF" 2>/dev/null | tr '\n' ' ')
  if [ -r /etc/resolv.conf ]; then
    _live=$(sed -n 's/^nameserver[[:space:]]*//p' /etc/resolv.conf 2>/dev/null | tr '\n' ' ')
    if [ "$_live" = "$_want" ]; then
      log Info "DNS 上游 $_want"
    else
      log Warn "DNS 覆盖还没挂上(当前 ${_live:-空}), 重启一次后生效"
    fi
  else
    log Warn "DNS: 还没有 /etc/resolv.conf, 重启一次后 MAGPIE_DNS 才会生效"
  fi
  return 0
}

# 把 magpie 命令挂进 PATH
ensure_cli() {
  _cli="$MODDIR/scripts/magpie-cli.sh"
  [ -x "$_cli" ] || return 0
  for _p in /data/adb/ksu/bin /data/adb/magisk /data/adb/ap/bin; do
    [ -d "$_p" ] || continue
    [ "$(readlink "$_p/magpie" 2>/dev/null)" = "$_cli" ] && return 0
    # PATH 是共享目录。保留其它文件、目录及悬空链接，不以 rm/ln -f 抢占名字。
    if [ -e "$_p/magpie" ] || [ -L "$_p/magpie" ]; then
      log Warn "保留已有的 $_p/magpie；模块包装器为 $_cli"
      continue
    fi
    ln -s "$_cli" "$_p/magpie" 2>/dev/null && return 0
  done
  return 0  # /system/bin/magpie 仍可用，不因兼容链接失败而拒绝启动
}

# 所有会启动新进程的入口都必须在启停锁内走这一检查。stop 仍然可用。
start_allowed() {
  if [ -e "$MODDIR/.uninstalling" ]; then
    log Error "模块正在卸载，拒绝启动"
    return 1
  fi
  if [ -e "$MODDIR/disable" ]; then
    log Error "模块已禁用，拒绝启动"
    return 1
  fi
  if [ -n "$ADDR_ERROR" ]; then
    log Error "$ADDR_ERROR"
    log Error "配置文件 $CONF"
    return 1
  fi
}

start() {
  start_allowed || return 1
  [ -z "${MAGPIE_CONF_ERROR:-}" ] || log Warn "$MAGPIE_CONF_ERROR"
  if [ "${1:-manual}" = auto ]; then
    # 消耗的是锁内观察的结果，而不是看门狗在锁外看到的旧快照。
    has_stop_request && return 2
    magpie_stop_intent_current "$USER_STOPPED" && return 2
  else
    with_stop_intent_lock clear_manual_stop_intent
    _start_intent_rc=$?
    if [ "$_start_intent_rc" -ne 0 ]; then
      [ "$_start_intent_rc" -ne 2 ] || log Info "收到停止请求，取消本次启动"
      return "$_start_intent_rc"
    fi
  fi
  # 清理必须在"已在运行"早退之前，否则覆盖安装后旧 dnsmasq 一直清不掉
  cleanup_legacy_dnsmasq
  # Remove the credential-bearing cache produced by older releases, including
  # when this start request finds the service already running.
  rm -f "$RUN/web.url" "$RUN/.web.url.$$" 2>/dev/null
  if pid=$(running); then
    echo "$pid" > "$PIDFILE" 2>/dev/null
    log Info "已在运行 (PID $pid)"
    return 0
  fi

  rm -f "$PIDFILE" 2>/dev/null

  # 主进程不在却有 mcp 子进程在跑：上次多半是崩溃或被强杀，子进程成了孤儿。
  # 不先收掉就启动，每次重启都会多留一批。只认 ` mcp ` 的命令行，
  # 用户手上正在跑的 magpie update / gateway-key 之类不会被误杀。
  for _p in $(magpie_mcp_pids 2>/dev/null); do
    log Warn "启动前清理孤儿进程 $_p"
    stop_magpie_pid "$_p" mcp 20 || :
  done

  [ -x "$BIN" ] || { log Error "找不到 $BIN"; return 1; }

  ensure_web_key || { log Error "无法读取或保存 WebUI 密钥，取消启动"; return 1; }
  clean_logs
  ensure_cli
  ensure_ca_bundle
  sync_resolv_conf

  export MAGPIE_ADDR MAGPIE_HOME="$magpie_path/data"
  export HOME="$magpie_path/data" TMPDIR="$RUN"
  export MAGPIE_WEB_KEY="$WEB_KEY"
  [ -s "$CA_BUNDLE" ] && export SSL_CERT_FILE="$CA_BUNDLE"
  # DNS 上游来自 /etc/resolv.conf（上面刚写好的 Magisk 覆盖）。
  # Go 与 magpie 都不认 DNS_LOCAL_HOSTNAMES，那个 export 已删除。
  export RES_OPTIONS="${RES_OPTIONS:-timeout:2 attempts:2}"
  # 自带的是 glibc 版 Bun，Android 上跑不起来，优先用 Android 版
  for _b in "$magpie_path/data/.cache/magpie/bun"/*/magpie-bun; do
    [ -x "$_b" ] && { MAGPIE_BUN="$_b"; export MAGPIE_BUN; break; }
  done

  # 不加 --web 就只有纯 API，没有网页。
  #
  # 用 setsid 让服务脱离调用者的会话与进程组：从管理器 [执行]、Termux、
  # 或任何「跑完就清理子进程组」的宿主里 start 时，父进程一退出，
  # 整个组会被连带收掉，表现为「启动成功、二三十秒后自己没了」。
  # 独立会话后就与调用者生死无关。
  #
  # 一律不带参数：setsid 的 -c 在 busybox 里是「强制 fork」，在 util-linux
  # 里却是「设置控制终端」，语义相反。误用 -c 会在没有 tty 的环境里
  # 直接失败（Inappropriate ioctl for device），服务根本起不来。
  start_allowed || return 1
  if has_stop_request || magpie_stop_intent_current "$USER_STOPPED"; then
    [ "${1:-manual}" = auto ] || log Info "启动准备期间收到停止请求，取消启动"
    return 2
  fi
  # 记下日志当前长度：失败时只看本次启动新写入的部分，旧报错不再误导诊断。
  _log_off=$(stat -c %s "$LOG" 2>/dev/null) || _log_off=0
  _new_session=""
  if command -v setsid >/dev/null 2>&1; then _new_session="setsid"; fi
  # shellcheck disable=SC2086  # $_new_session 要么空、要么是两个词，故意分词
  ( exec 9>&-; cd "$magpie_path/data" && exec $_new_session "$BIN" serve --web="$WEB_HOST" ) >>"$LOG" 2>&1 &
  # 等进程就绪，最多 6 秒
  _i=0
  while [ "$_i" -lt 12 ] && ! running >/dev/null; do
    sleep 0.5
    _i=$((_i + 1))
  done

  if pid=$(running); then
    # PIDFILE 在这里写而不是启动后立刻写：setsid 在部分实现里会 fork 一次，
    # 紧接着的 $! 可能是中间进程、不是 serve。按实际探测到的 pid 记才准。
    echo "$pid" > "$PIDFILE" 2>/dev/null
    log Info "已启动 网关 http://$MAGPIE_ADDR"
    log Info "      WebUI http://127.0.0.1:$WEB_PORT/?k=<redacted> (PID $pid)"
    pin_oom "$pid"
    command -v magpie_harden_perms >/dev/null 2>&1 && magpie_harden_perms "$magpie_path"
    # 二进制自己报的地址会被 fake-ip 骗，这里自己算
    refresh_lan_url || true
    if [ -f "$RUN/lan.url" ]; then
      log Info "      局域网 $(cat "$RUN/lan.url" 2>/dev/null)"
    fi
  else
    rm -f "$PIDFILE" 2>/dev/null
    if tail -c +"$((_log_off + 1))" "$LOG" 2>/dev/null | grep -q "address already in use"; then
      log Error "启动失败: 端口被占用, 可能上次进程还没退出。详见 $LOG"
    else
      log Error "启动失败, 详见 $LOG"
    fi
    return 1
  fi
}

stop() {
  # 即使杀不净仍保留意图。写失败也继续尝试停服，但不谎报全部成功。
  _stop_result=0
  if ! with_stop_intent_lock write_stop_intent; then
    log Error "无法保存本次开机的停止意图"
    _stop_result=1
  fi
  cleanup_legacy_dnsmasq
  _stop_mains=$(magpie_command_pids serve 2>/dev/null)
  if [ -n "$_stop_mains" ]; then
    for _stop_pid in $_stop_mains; do
      log Warn "正在停止 (PID $_stop_pid)"
      stop_magpie_pid "$_stop_pid" serve 20 || _stop_result=1
    done
  else
    log Info "主进程未在运行"
  fi

  # 主进程被强杀时，MCP 可能变成孤儿；绝不用包含普通 CLI 的 all_pids。
  for _stop_pid in $(magpie_mcp_pids 2>/dev/null); do
    if stop_magpie_pid "$_stop_pid" mcp 10; then
      log Info "已收掉残留进程 $_stop_pid"
    else
      _stop_result=1
    fi
  done

  # 全量后置核验，而不是只相信 kill 返回值/第一个主进程。期间出现新的
  # serve/MCP 也要报告停止失败，让直接 stop 和 restart 都能失败关闭。
  _stop_mains=$(magpie_command_pids serve 2>/dev/null)
  _stop_mcps=$(magpie_mcp_pids 2>/dev/null)
  if [ -n "$_stop_mains$_stop_mcps" ]; then
    log Error "停止失败，仍有服务进程 (serve: ${_stop_mains:-无}; mcp: ${_stop_mcps:-无})"
    _stop_result=1
  fi
  [ "$_stop_result" -ne 0 ] || rm -f "$PIDFILE" || _stop_result=1
  return "$_stop_result"
}

sync_status() {
  [ -f "$(dirname "$0")/status.sh" ] && sh "$(dirname "$0")/status.sh" >/dev/null 2>&1
}

# 每条 start/stop 路径都可能建「停止意图」标记并拿启停锁。
# 进程若在临界区里被信号打断（TERM/HUP/INT），只放锁、不清标记，
# 会留下一个 .stop-request.<pid>：has_stop_request 发现它属于死进程时会顺手清掉，
# 但下次 stop 完成前若又被信号打断，残留的标记可能把一次「较新的启动」误判成该取消。
# 所以把「放锁 + 清自己那条停止标记」绑进同一个 trap，任何退出路径都会走到。
STOP_REQUEST_FILE=""
cleanup_lifecycle() {
  release_service_lock
  end_stop_request || :
}

# 信号处理只退出，由 EXIT 统一清理；绝不释放锁后继续临界区。
# 必须先装 trap，再建停止标记或打开锁 FD。
exec 9>&-  # 预留本脚本的 FD，不解锁调用者可能传入的同号 FD。
trap cleanup_lifecycle EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# stop 的停止意图需要在等锁前发布；只为写操作准备 run，不触碰 data。
case "$1" in
  toggle-if)
    case "${2:-}:$#" in running:2|stopped:2) ;; *) echo failed; exit 1 ;; esac ;;
esac
case "$1" in
  auto-start|start|stop|restart|toggle|toggle-if)
    [ ! -L "$RUN" ] && mkdir -p "$RUN" || exit 1 ;;
esac

# 输出控制器已核验、仍对应当前 Web 配置的无凭据回环面板地址；不能确认就失败。
verified_panel_url() {
  start_allowed >/dev/null || return 1
  command -v magpie_listener_pid >/dev/null 2>&1 || return 1
  [ "$API_PORT" != "$WEB_PORT" ] || return 1
  _vp_pid=$(magpie_listener_pid) || return 1
  _panel_bind=$(magpie_port_observation "$_vp_pid" "$WEB_PORT")
  # 刚保存但未应用的 Web 配置不能指向同一进程的其它端口。
  magpie_process_web_binding "$_vp_pid" "$WEB_HOST" || return 1
  case "$_panel_bind" in
    'local '*) printf 'http://%s:%s/\n' "${_panel_bind#local }" "$WEB_PORT" ;;
    *) return 1 ;;
  esac
}

case "$1" in
  # 退出码要带出 start 的结果，否则失败也返回 0
  auto-start)
    acquire_service_lock || exit 1
    start auto; _rc=$?
    if [ "$_rc" -ne 2 ]; then sync_status; fi
    exit "$_rc" ;;
  start)
    acquire_service_lock || exit 1
    start; _rc=$?; sync_status; exit "$_rc" ;;
  stop)
    begin_stop_request || exit 1
    # 能在启停锁外发布，不允许一次更新比它早的 start 擦掉这个请求。
    if ! with_stop_intent_lock write_stop_intent; then
      log Warn "等待启停锁前未能保存停止标记，取得锁后再尝试"
    fi
    acquire_service_lock || exit 1
    stop; _rc=$?
    end_stop_request || _rc=1
    sync_status; exit "$_rc" ;;
  restart)
    begin_stop_request || exit 1
    acquire_service_lock || exit 1
    # 配置/维护状态不合法时不先停，也不留下永久停止标记。
    start_allowed || exit 1
    stop; _rc=$?
    end_stop_request || _rc=1
    if [ "$_rc" -eq 0 ]; then start; _rc=$?; fi
    sync_status; exit "$_rc" ;;
  status)  pid=$(running) && echo "running (PID $pid)" || echo "stopped" ;;
  # 给普通前台 App 的外部浏览器提供不带密钥的面板地址；不能把 web.key
  # 或 ?k=... 放进通用 Intent、剪贴板或状态快照。
  panel-url)
    verified_panel_url || exit 1
    exit 0 ;;
  # 仅供 root 管理器 WebUI（ksu.exec）在同一 WebView 内打开本体面板（P1）：
  # 现读 web.key 只写到 stdout，不落盘、不写日志、不进 status.json。
  webui-url)
    _wu=$(verified_panel_url) || exit 1
    [ -s "$WEB_KEY_FILE" ] || exit 1
    _wk=$(head -n 1 "$WEB_KEY_FILE" 2>/dev/null) || exit 1
    case "$_wk" in ''|*[!A-Za-z0-9_-]*) exit 1 ;; esac
    printf '%s?k=%s\n' "$_wu" "$_wk"
    exit 0 ;;

  # 旧 toggle 继续给 CLI / 旧磁贴使用。新磁贴必须明确自己看到的状态，
  # 进锁后若状态已变，只让客户端刷新，绝不把这次点按改成相反动作。
  toggle|toggle-if)
    acquire_service_lock || exit 1
    if pid=$(running); then _toggle_actual=running; else _toggle_actual=stopped; fi
    if [ "$1" = toggle-if ] && [ "$2" != "$_toggle_actual" ]; then
      printf 'stale %s\n' "$_toggle_actual"
      exit 3
    fi
    if [ "$_toggle_actual" = running ]; then
      begin_stop_request || { echo failed; exit 1; }
      stop; _rc=$?
      end_stop_request || _rc=1
      sync_status
      if [ "$_rc" -ne 0 ] || running >/dev/null; then
        echo "failed"; _rc=1
      else
        echo "stopped"
      fi
      exit $_rc
    fi
    start
    _rc=$?
    sync_status
    # start 的返回值不是服务状态：较新的 stop 可让它取消（2），即使返回
    # 成功，进程也可能已经退出。只按后置探测输出 running。
    if [ "$_rc" -eq 2 ]; then
      if running >/dev/null; then echo "failed"; _rc=1; else echo "stopped"; fi
    elif [ "$_rc" -eq 0 ] && running >/dev/null; then
      echo "running"
    else
      echo "failed"
      [ "$_rc" -ne 0 ] || _rc=1
    fi
    exit $_rc
    ;;

  *)       echo "用法: $0 {start|stop|restart|status|panel-url|webui-url|auto-start|toggle|toggle-if <running|stopped>}"; exit 1 ;;
esac
