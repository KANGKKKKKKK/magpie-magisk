#!/system/bin/sh
# magpie 服务控制: magpie.service {start|stop|restart|status}

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

# 读配置；文件缺失时用内置默认值
CONF="${MAGPIE_CONF:-/data/adb/magpie/scripts/magpie.config}"
[ -f "$CONF" ] || CONF="$(dirname "$0")/magpie.config"
[ -f "$CONF" ] && . "$CONF" 2>/dev/null

magpie_path=${magpie_path:-/data/adb/magpie}
MAGPIE_ADDR=${MAGPIE_ADDR:-127.0.0.1:3425}
MAGPIE_DNS=${MAGPIE_DNS:-"223.5.5.5 119.29.29.29 8.8.8.8"}

BIN="$magpie_path/bin/magpie"
RUN="$magpie_path/run"
PIDFILE="$RUN/magpie.pid"
LOG="$RUN/magpie.log"

# 局域网地址规则与 status.sh / action.sh / doctor.sh 共用同一份实现。
# 必须在算端口之前 source：下面要用 addr_port / addr_host / is_loopback_host。
_NETLIB="$(dirname "$0")/lib.sh"
if [ -f "$_NETLIB" ]; then
  . "$_NETLIB"
else
  lan_ip() { return 1; }
  addr_host() { case "$1" in \[*\]:*) _h=${1#\[}; echo "${_h%%\]*}" ;; *:*) echo "${1%:*}" ;; *) echo "$1" ;; esac; }
  addr_port() { case "$1" in \[*\]:*) _p=${1##*\]:} ;; *:*) _p=${1##*:} ;; *) return 1 ;; esac; case "$_p" in ''|*[!0-9]*) return 1 ;; esac; echo "$_p"; }
  is_loopback_host() { _h=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); case "$_h" in 127.*|localhost|::1|\[::1\]|::ffff:127.*) return 0 ;; esac; return 1; }
  # lib.sh 缺失时也要能生成出东西，但**不做半套校验**：
  # 一个看起来做了校验、实际漏判的实现，比明说「没校验」更容易骗过人。
  # 真正的过滤在 lib.sh 里，这里只保证「非空项原样写出去」，
  # 有效性仍由 sync_resolv_conf 最后的 `grep '^nameserver '` 兜底。
  magpie_resolv_body() {
    for _ns in $1; do
      [ -n "$_ns" ] || continue
      echo "nameserver $_ns"
    done
    echo "options timeout:2 attempts:2"
  }
  magpie_bad_dns() { return 0; }
fi

WEB_HOST=${MAGPIE_WEB_ADDR:-"${MAGPIE_ADDR%:*}:3430"}

# 端口必须能解析出来：写成 127.0.0.1（漏端口）时不让它启动。
# 静默用默认端口跑起来，用户只会看到「已启动」然后连不上，更难查。
API_PORT=$(addr_port "$MAGPIE_ADDR" 2>/dev/null)
WEB_PORT=$(addr_port "$WEB_HOST" 2>/dev/null)
ADDR_ERROR=""
if [ -z "$API_PORT" ]; then
  ADDR_ERROR="MAGPIE_ADDR=$MAGPIE_ADDR 的端口不可用（应为 主机:端口，1-65535；IPv6 用 [::1]:3425）"
elif [ -z "$WEB_PORT" ]; then
  ADDR_ERROR="面板监听地址 $WEB_HOST 的端口不可用（MAGPIE_WEB_ADDR 应为 主机:端口）"
fi

# run / data 目录必须在写任何文件之前建好：
# 否则下面写 web.key 会失败（data 还不存在），面板密钥每次启动都换一个。
mkdir -p "$RUN" "$magpie_path/data"

# 密钥固定，否则每次重启 WebUI 链接都会变
WEB_KEY_FILE="$magpie_path/data/web.key"
if [ -s "$WEB_KEY_FILE" ]; then
  WEB_KEY=$(cat "$WEB_KEY_FILE" 2>/dev/null)
  chmod 600 "$WEB_KEY_FILE" 2>/dev/null
else
  WEB_KEY=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 32)
  _web_key_tmp="$magpie_path/data/.web.key.$$"
  if [ -n "$WEB_KEY" ] && ( umask 077; printf '%s\n' "$WEB_KEY" > "$_web_key_tmp" ) 2>/dev/null; then
    chmod 600 "$_web_key_tmp" 2>/dev/null
    mv -f "$_web_key_tmp" "$WEB_KEY_FILE" 2>/dev/null
  fi
  rm -f "$_web_key_tmp" 2>/dev/null
fi
WEB_URL=""
[ -n "$WEB_PORT" ] && WEB_URL="http://127.0.0.1:$WEB_PORT/?k=$WEB_KEY"

# 带日期，跨天也能对上时间线
log() { echo "$(date +'%Y-%m-%d %H:%M:%S') [$1] $2"; }

LOG_MAX_BYTES=5242880

# 超过 5MB 归档为 .1，必须在进程打开日志 fd 之前调用。
# 实现在 lib.sh（service.sh 共用同一份），这里只补说明行。
# lib.sh 缺失时不轮转、也不每轮喊一次：那种状态下日志变大不是最要紧的问题，
# 刷屏反而会把它盖住。只在真的超了阈值时提一句。
rotate_log() {
  _f="$1"
  _sz=$(stat -c %s "$_f" 2>/dev/null)
  [ -n "$_sz" ] && [ "$_sz" -gt "$LOG_MAX_BYTES" ] 2>/dev/null || return 0
  if command -v magpie_rotate_log >/dev/null 2>&1; then
    magpie_rotate_log "$_f" "$LOG_MAX_BYTES"
  else
    log Warn "lib.sh 缺失, 日志轮转跳过（${_f##*/} 已超 5MB）"
    return 0
  fi
  log Info "日志超 5MB, 已归档为 ${_f##*/}.1"
}

clean_logs() { rotate_log "$LOG"; }

# DNS：magpie 本体是不链接 libc 的 Go 静态 PIE，cgo 解析器不可用，只能走纯 Go 解析器。
# 纯 Go 解析器只认 /etc/resolv.conf；Android 没有这个文件，读不到就退回
# 127.0.0.1:53 / [::1]:53（那里没人监听），于是原生通道全部 connection refused。
# 所以模块自带 system/etc/resolv.conf，由 Magisk 覆盖到 /etc/resolv.conf；
# 下面 sync_resolv_conf 按 MAGPIE_DNS 重写那份覆盖文件。
# 注意 Go 标准库并没有 DNS_LOCAL_HOSTNAMES 这个变量（本体里也搜不到），
# v0.9.0 及以前注入的 export 从来没生效过。
DNS_SERVERS="$MAGPIE_DNS"
RESOLV_CONF="$RUN/resolv.conf"
USER_STOPPED="$RUN/.user_stopped"
SERVICE_LOCK="$RUN/.service.lock"
SERVICE_LOCK_HELD=""

# 启停操作串行执行。停止请求先落盘再等待锁：即使较早的 start 仍在运行，
# 它也不会把较新的停止意图清掉；stop 获得锁后会做最终收尾。

# /proc/<pid>/starttime 是「这次启动的实例号」，PID 复用后一定会变。
# 与锁文件里记的 pid 一起比对，能把「PID 恰好被复用」误判成「锁主还活着」
# 的窗口压到最低（TOCTOU）。
proc_starttime() {
  [ -r "/proc/$1/stat" ] || return 1
  # comm 里可能含空格和右括号（如 ")(worker)"），按最后一个 ')' 切，第 22 列才是 starttime
  _stat=$(sed -n 's/.*) //p' "/proc/$1/stat" 2>/dev/null)
  # shellcheck disable=SC2086  # 故意分词：把 /proc/stat 的字段按空白拆成位置参数
  set -- $_stat
  # 去掉前 19 个字段（state..startstack），第 20 个就是原第 22 列 starttime
  [ "$#" -ge 20 ] || return 1
  shift 19
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  echo "$1"
}

acquire_service_lock() {
  _i=0
  while ! mkdir "$SERVICE_LOCK" 2>/dev/null; do
    _owner=$(cat "$SERVICE_LOCK/pid" 2>/dev/null)
    _ost=$(cat "$SERVICE_LOCK/starttime" 2>/dev/null)
    case "$_owner" in ''|*[!0-9]*) _owner="" ;; esac
    case "$_ost"   in ''|*[!0-9]*) _ost=""   ;; esac
    _stale=""
    if [ -z "$_owner" ]; then
      # 读不到 owner：不是「没有锁主」，是锁目录建了一半。
      # 交给下一次循环重读；反复读不到就按超时处理，绝不当成「没人」硬抢。
      :
    elif ! kill -0 "$_owner" 2>/dev/null; then
      _stale=1                      # 进程已死
    elif [ -n "$_ost" ]; then
      _nowst=$(proc_starttime "$_owner" 2>/dev/null)
      if [ -n "$_nowst" ] && [ "$_nowst" != "$_ost" ]; then
        _stale=1                    # starttime 对不上：PID 已被复用
      fi
    fi
    if [ -n "$_stale" ]; then
      _s="$SERVICE_LOCK.stale.$$"
      mv "$SERVICE_LOCK" "$_s" 2>/dev/null && rm -rf "$_s" 2>/dev/null
      continue
    fi
    [ "$_i" -lt 150 ] || { log Error "另一个启停操作仍在进行，请稍后重试"; return 1; }
    sleep 0.1; _i=$((_i + 1))
  done
  # 先落盘自己的实例号再记 pid：读方拿到 pid 时 starttime 必然已可核对，
  # 不会出现「pid 在、starttime 还没写」的中间态被误判成新锁主。
  proc_starttime $$ > "$SERVICE_LOCK/starttime" 2>/dev/null
  echo $$ > "$SERVICE_LOCK/pid" 2>/dev/null
  SERVICE_LOCK_HELD=1
}
release_service_lock() {
  [ -n "$SERVICE_LOCK_HELD" ] || return 0
  SERVICE_LOCK_HELD=""
  rm -rf "$SERVICE_LOCK" 2>/dev/null
}
has_stop_request() {
  for _r in "$RUN"/.stop-request.*; do
    [ -e "$_r" ] || continue
    _rp=${_r##*.}
    case "$_rp" in ''|*[!0-9]*) continue ;; esac
    if kill -0 "$_rp" 2>/dev/null; then return 0; fi
    rm -f "$_r" 2>/dev/null
  done
  return 1
}
CA_BUNDLE="$magpie_path/data/certs/ca-bundle.crt"
CA_STAMP="$CA_BUNDLE.stamp"

# 模块目录：DNS 覆盖文件写在这里。脚本被软链调用时 $0 可能是别的路径，兜底到默认位置。
MODDIR=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)
[ -n "$MODDIR" ] || MODDIR=/data/adb/modules/magpie
RESOLV_OVERLAY="$MODDIR/system/etc/resolv.conf"

# 把 run/lan.url 刷成当前地址；没有可用地址就删掉它。
# 返回 0 表示内容有变化（调用方据此决定要不要刷新状态）。
refresh_lan_url() {
  _new=$(lan_ip)
  _old=$(cat "$RUN/lan.url" 2>/dev/null)
  _old=$(echo "$_old" | sed -n 's#^http://\([^:]*\):.*#\1#p')
  if [ "$_new" = "$_old" ]; then
    return 1
  fi
  if [ -n "$_new" ]; then
    echo "http://$_new:$WEB_PORT" > "$RUN/lan.url" 2>/dev/null
    log Info "局域网地址更新为 http://$_new:$WEB_PORT"
  else
    rm -f "$RUN/lan.url" 2>/dev/null
    log Info "当前没有可用的局域网地址, 已清除对外地址"
  fi
  return 0
}

# 进程防杀：root 起的进程默认已是 -1000，这里只做校验，
# 若被外部改过（某些省电模块会重设）就改回来。
pin_oom() {
  _p="$1"
  [ -n "$_p" ] && [ -d "/proc/$_p" ] || return 1
  _cur=$(cat "/proc/$_p/oom_score_adj" 2>/dev/null)
  [ "$_cur" = "-1000" ] && return 0
  if echo -1000 > "/proc/$_p/oom_score_adj" 2>/dev/null; then
    log Info "oom_score_adj $_cur -> -1000"
  else
    log Warn "无法设置 oom_score_adj (当前 $_cur)"
  fi
}


running() {
  # 只认 serve 主进程。MCP 子进程（magpie mcp vision/search/image）也叫 magpie，
  # 用 pidof | head -1 会取到它们，导致判断错误、stop 杀错进程。
  pid=$(magpie_main_pid) || { rm -f "$PIDFILE" 2>/dev/null; return 1; }
  echo "$pid" > "$PIDFILE" 2>/dev/null
  echo "$pid"
  return 0
}

# 清理 v0.2 遗留的 dnsmasq（监听 ::1:53）。
# 只认命令行里的 listen-address=::1，绝不 pkill 系统热点的 dnsmasq。
legacy_kind() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ -r "/proc/$1/cmdline" ] || return 1
  _cl=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null)
  case "$_cl" in
    *listen-address=::1*) echo dnsmasq; return 0 ;;
    "sleep 2147483647 "*)
      # 老版本用 sleep 2147483647 顶住 FIFO。读 fd 链接判断是不是它：
      # 用 case 而不是 ls | grep，文件名带特殊字符也不会误判。
      for _fd in /proc/"$1"/fd/*; do
        _tgt=$(readlink "$_fd" 2>/dev/null) || continue
        case "$_tgt" in *dnsmasq.fifo*) echo keep; return 0 ;; esac
      done
      ;;
  esac
  return 1
}

stop_pid() {
  kill "$1" 2>/dev/null || return 0
  _i=0
  while kill -0 "$1" 2>/dev/null && [ "$_i" -lt 20 ]; do
    sleep 0.1; _i=$((_i + 1))
  done
  kill -9 "$1" 2>/dev/null
  return 0
}

cleanup_legacy_dnsmasq() {
  _cands="$(cat "$RUN/dnsmasq.pid" 2>/dev/null) $(cat "$RUN/dnsmasq.keep.pid" 2>/dev/null)"
  for _n in dnsmasq sleep; do
    _cands="$_cands $(pidof "$_n" 2>/dev/null)"
  done

  _seen=""; _found=""
  for _p in $_cands; do
    case " $_seen " in *" $_p "*) continue ;; esac
    _kind=$(legacy_kind "$_p") || continue
    _seen="$_seen $_p"
    stop_pid "$_p"
    _found="$_found $_p($_kind)"
  done

  [ -n "$_found" ] && log Info "已清理旧版 dnsmasq 残留:$_found"
  rm -f "$RUN/dnsmasq.pid" "$RUN/dnsmasq.keep.pid" "$RUN/dnsmasq.fifo" "$RUN/dnsmasq.log" 2>/dev/null
  return 0
}

# 系统证书目录指纹：文件数 + 目录 mtime。
# 装/卸根证书模块、系统升级换了 CA 库，指纹都会变，下次启动自动重建。
# 实现在 lib.sh（magpie-cli.sh 共用同一份）。不在这里留第二份实现：
# 两份指纹算法一旦漂移，会出现「证书明明变了却不重建」这种极难查的问题。
ca_fingerprint() {
  if command -v magpie_ca_fingerprint >/dev/null 2>&1; then
    magpie_ca_fingerprint
    return 0
  fi
  echo "lib.sh-missing"
}

# Go 找不到 Android 证书库，合并系统证书交给 SSL_CERT_FILE。
# 合并本身在 lib.sh（magpie-cli.sh 共用同一份），这里负责指纹比对、写 stamp 与措辞。
# 指纹只取一次：以前是「比对时算一次、写 stamp 时再算一次」，
# 两次之间目录 mtime 变了就会写进一个永远匹配不上的 stamp，下次启动白重建一遍。
ensure_ca_bundle() {
  _fp=$(ca_fingerprint)
  if [ -s "$CA_BUNDLE" ] && [ "$(cat "$CA_STAMP" 2>/dev/null)" = "$_fp" ]; then
    return 0
  fi

  if ! command -v magpie_write_ca_bundle >/dev/null 2>&1; then
    log Error "lib.sh 缺失, 无法生成 CA 证书包（HTTPS 请求会失败）"
    [ -s "$CA_BUNDLE" ] && return 0
    return 1
  fi

  if _n=$(magpie_write_ca_bundle "$CA_BUNDLE" 2>/dev/null); then
    echo "$_fp" > "$CA_STAMP" 2>/dev/null
    log Info "已生成 CA 证书包 ($_n 张)"
    return 0
  fi

  [ -s "$CA_BUNDLE" ] && { log Warn "CA 证书包重建失败, 继续用旧包"; return 0; }
  log Warn "无法生成 CA 证书包, HTTPS 请求可能失败"
  return 1
}

# 按 MAGPIE_DNS 生成 DNS 配置，写到两处：
#   $RUN/resolv.conf                     本机参照，也方便 user 直接 cat
#   $MODDIR/system/etc/resolv.conf       Magisk 覆盖，开机后就是 /etc/resolv.conf
# 覆盖文件是 magpie 唯一的上游来源，所以这里失败就等于原生通道全废，要出声。
sync_resolv_conf() {
  # 逐条点名被跳过的项：只写「格式不对」，用户不知道是哪一条，
  # 也容易误以为整份配置都没生效（实际是其余项照常写入了）。
  _bad=$(magpie_bad_dns "$DNS_SERVERS" 2>/dev/null | tr '\n' ' ')
  [ -n "$_bad" ] && log Warn "MAGPIE_DNS 里这些项不是合法地址, 已跳过: $_bad"

  magpie_resolv_body "$DNS_SERVERS" > "$RESOLV_CONF.tmp" 2>/dev/null
  # 没有一条 nameserver 就用不了（Go 会退回 127.0.0.1:53），宁可保留旧的
  if [ ! -s "$RESOLV_CONF.tmp" ] || ! grep -q '^nameserver ' "$RESOLV_CONF.tmp" 2>/dev/null; then
    rm -f "$RESOLV_CONF.tmp" 2>/dev/null
    log Warn "MAGPIE_DNS 里没有一条可用地址, 保留现有 DNS 配置"
    return 1
  fi
  chmod 644 "$RESOLV_CONF.tmp" 2>/dev/null
  mv -f "$RESOLV_CONF.tmp" "$RESOLV_CONF" 2>/dev/null

  # 只有真模块目录才写覆盖：测试沙箱里 MODDIR 指向临时目录，
  # 不挡一下会在那里凭空造出一个 system/etc/ 来。
  if [ -f "$MODDIR/module.prop" ]; then
    mkdir -p "$MODDIR/system/etc" 2>/dev/null
    if ! cmp -s "$RESOLV_CONF" "$RESOLV_OVERLAY" 2>/dev/null; then
      cp -f "$RESOLV_CONF" "$RESOLV_OVERLAY" 2>/dev/null && chmod 644 "$RESOLV_OVERLAY" 2>/dev/null
    fi
  fi

  _want=$(sed -n 's/^nameserver[[:space:]]*//p' "$RESOLV_CONF" 2>/dev/null | tr '\n' ' ')
  if [ -r /etc/resolv.conf ]; then
    _live=$(sed -n 's/^nameserver[[:space:]]*//p' /etc/resolv.conf 2>/dev/null | tr '\n' ' ')
    if [ "$_live" = "$_want" ]; then
      log Info "DNS 上游 $_want"
    else
      log Warn "DNS 覆盖还没挂上(当前 ${_live:-空}), 重启一次后生效"
    fi
  else
    log Warn "DNS: 还没有 /etc/resolv.conf, 重启一次后 MAGPIE_DNS 才会生效"
  fi
  return 0
}

# 把 magpie 命令挂进 PATH
ensure_cli() {
  _sd=$(dirname "$0")
  case "$_sd" in
    /*) _cli="$_sd/magpie-cli.sh" ;;
    *)  _cli="$(pwd)/$_sd/magpie-cli.sh" ;;
  esac
  [ -f "$_cli" ] || return 0
  chmod 755 "$_cli" 2>/dev/null
  for _p in /data/adb/ksu/bin /data/adb/magisk /data/adb/ap/bin; do
    [ -d "$_p" ] || continue
    [ "$(readlink "$_p/magpie" 2>/dev/null)" = "$_cli" ] && return 0
    rm -f "$_p/magpie" 2>/dev/null
    ln -sf "$_cli" "$_p/magpie" 2>/dev/null && return 0
  done
}

start() {
  # 端口读不出来就不启动：用默认端口跑起来只会让「已启动」和「连不上」同时出现
  if [ -n "$ADDR_ERROR" ]; then
    log Error "$ADDR_ERROR"
    log Error "配置文件 $CONF"
    return 1
  fi
  if has_stop_request; then
    log Info "收到较新的停止请求，取消本次启动"
    return 0
  fi
  rm -f "$USER_STOPPED" 2>/dev/null
  # 清理必须在"已在运行"早退之前，否则覆盖安装后旧 dnsmasq 一直清不掉
  cleanup_legacy_dnsmasq
  if pid=$(running); then
    log Info "已在运行 (PID $pid)"
    return 0
  fi

  # 主进程不在却有 mcp 子进程在跑：上次多半是崩溃或被强杀，子进程成了孤儿。
  # 不先收掉就启动，每次重启都会多留一批。只认 ` mcp ` 的命令行，
  # 用户手上正在跑的 magpie update / gateway-key 之类不会被误杀。
  for _p in $(magpie_mcp_pids 2>/dev/null); do
    log Warn "启动前清理孤儿进程 $_p"
    stop_pid "$_p"
  done

  [ -x "$BIN" ] || { log Error "找不到 $BIN"; return 1; }

  clean_logs
  ensure_cli
  ensure_ca_bundle
  sync_resolv_conf

  export MAGPIE_ADDR MAGPIE_HOME="$magpie_path/data"
  export HOME="$magpie_path/data" TMPDIR="$RUN"
  export MAGPIE_WEB_KEY="$WEB_KEY"
  [ -s "$CA_BUNDLE" ] && export SSL_CERT_FILE="$CA_BUNDLE"
  # DNS 上游来自 /etc/resolv.conf（上面刚写好的 Magisk 覆盖）。
  # Go 与 magpie 都不认 DNS_LOCAL_HOSTNAMES，那个 export 已删除。
  export RES_OPTIONS="${RES_OPTIONS:-timeout:2 attempts:2}"
  # 自带的是 glibc 版 Bun，Android 上跑不起来，优先用 Android 版
  for _b in "$magpie_path/data/.cache/magpie/bun"/*/magpie-bun; do
    [ -x "$_b" ] && { MAGPIE_BUN="$_b"; export MAGPIE_BUN; break; }
  done

  # 不加 --web 就只有纯 API，没有网页。
  #
  # 用 setsid 让服务脱离调用者的会话与进程组：从管理器 [执行]、Termux、
  # 或任何「跑完就清理子进程组」的宿主里 start 时，父进程一退出，
  # 整个组会被连带收掉，表现为「启动成功、二三十秒后自己没了」。
  # 独立会话后就与调用者生死无关。
  #
  # 一律不带参数：setsid 的 -c 在 busybox 里是「强制 fork」，在 util-linux
  # 里却是「设置控制终端」，语义相反。误用 -c 会在没有 tty 的环境里
  # 直接失败（Inappropriate ioctl for device），服务根本起不来。
  _new_session=""
  if command -v setsid >/dev/null 2>&1; then _new_session="setsid"; fi
  # shellcheck disable=SC2086  # $_new_session 要么空、要么是两个词，故意分词
  ( cd "$magpie_path/data" && exec $_new_session "$BIN" serve --web="$WEB_HOST" ) >>"$LOG" 2>&1 &
  _web_url_tmp="$RUN/.web.url.$$"
  ( umask 077; printf '%s\n' "$WEB_URL" > "$_web_url_tmp" ) 2>/dev/null && \
    mv -f "$_web_url_tmp" "$RUN/web.url" 2>/dev/null
  rm -f "$_web_url_tmp" 2>/dev/null
  chmod 600 "$RUN/web.url" 2>/dev/null

  # 等进程就绪，最多 6 秒
  _i=0
  while [ "$_i" -lt 12 ] && ! running >/dev/null; do
    sleep 0.5
    _i=$((_i + 1))
  done

  if pid=$(running); then
    # PIDFILE 在这里写而不是启动后立刻写：setsid 在部分实现里会 fork 一次，
    # 紧接着的 $! 可能是中间进程、不是 serve。按实际探测到的 pid 记才准。
    echo "$pid" > "$PIDFILE" 2>/dev/null
    log Info "已启动 网关 http://$MAGPIE_ADDR"
    log Info "      WebUI http://127.0.0.1:$WEB_PORT/?k=<redacted> (PID $pid)"
    pin_oom "$pid"
    # 二进制自己报的地址会被 fake-ip 骗，这里自己算
    refresh_lan_url || true
    if [ -f "$RUN/lan.url" ]; then
      log Info "      局域网 $(cat "$RUN/lan.url" 2>/dev/null)"
    fi
  else
    rm -f "$PIDFILE" 2>/dev/null
    if grep -q "address already in use" "$LOG" 2>/dev/null; then
      log Error "启动失败: 端口被占用, 可能上次进程还没退出。详见 $LOG"
    else
      log Error "启动失败, 详见 $LOG"
    fi
    return 1
  fi
}

stop() {
  # 打标记，免得看门狗又拉起来
  : > "$USER_STOPPED" 2>/dev/null
  cleanup_legacy_dnsmasq
  pid=$(running)
  if [ -n "$pid" ]; then
    log Warn "正在停止 (PID $pid)"
    kill -15 "$pid" 2>/dev/null
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
      sleep 0.1; i=$((i + 1))
    done
    kill -9 "$pid" 2>/dev/null
  else
    # 主进程已经不在了，但下面那段孤儿清理仍必须跑
    log Info "主进程未在运行"
  fi

  # 兜底：主进程被强杀时，MCP 子进程可能变成孤儿留在后台
  for _p in $(magpie_all_pids); do
    kill -15 "$_p" 2>/dev/null
    _j=0
    while kill -0 "$_p" 2>/dev/null && [ "$_j" -lt 10 ]; do
      sleep 0.1; _j=$((_j + 1))
    done
    kill -9 "$_p" 2>/dev/null
    log Info "已收掉残留进程 $_p"
  done

  rm -f "$PIDFILE"
}

sync_status() {
  [ -f "$(dirname "$0")/status.sh" ] && sh "$(dirname "$0")/status.sh" >/dev/null 2>&1
}

# 每条 start/stop 路径都可能建「停止意图」标记并拿启停锁。
# 进程若在临界区里被信号打断（TERM/HUP/INT），只放锁、不清标记，
# 会留下一个 .stop-request.<pid>：has_stop_request 发现它属于死进程时会顺手清掉，
# 但下次 stop 完成前若又被信号打断，残留的标记可能把一次「较新的启动」误判成该取消。
# 所以把「放锁 + 清自己那条停止标记」绑进同一个 trap，任何退出路径都会走到。
STOP_REQUEST_FILE=""
cleanup_lifecycle() {
  release_service_lock
  [ -n "$STOP_REQUEST_FILE" ] && rm -f "$STOP_REQUEST_FILE" 2>/dev/null
  STOP_REQUEST_FILE=""
}

case "$1" in
  # 退出码要带出 start 的结果，否则失败也返回 0
  start)
    acquire_service_lock || exit 1; trap cleanup_lifecycle EXIT INT TERM HUP
    start; _rc=$?; sync_status; exit $_rc ;;
  stop)
    : > "$USER_STOPPED" 2>/dev/null
    STOP_REQUEST_FILE="$RUN/.stop-request.$$"; : > "$STOP_REQUEST_FILE" 2>/dev/null
    acquire_service_lock || { _rc=$?; rm -f "$STOP_REQUEST_FILE"; STOP_REQUEST_FILE=""; exit $_rc; }
    trap cleanup_lifecycle EXIT INT TERM HUP
    stop; _rc=$?; rm -f "$STOP_REQUEST_FILE"; STOP_REQUEST_FILE=""; sync_status; exit $_rc ;;
  restart)
    : > "$USER_STOPPED" 2>/dev/null
    STOP_REQUEST_FILE="$RUN/.stop-request.$$"; : > "$STOP_REQUEST_FILE" 2>/dev/null
    acquire_service_lock || { _rc=$?; rm -f "$STOP_REQUEST_FILE"; STOP_REQUEST_FILE=""; exit $_rc; }
    trap cleanup_lifecycle EXIT INT TERM HUP
    stop; rm -f "$STOP_REQUEST_FILE"; STOP_REQUEST_FILE=""; start; _rc=$?; sync_status; exit $_rc ;;
  status)  pid=$(running) && echo "running (PID $pid)" || echo "stopped" ;;

  # 在跑就停，没跑就起。给磁贴 / 快捷方式用：一个动作，不用先判断状态。
  # 停止走的是同一个 stop()，所以 .user_stopped 照样会写，看门狗不会又拉回来；
  # start() 会清掉那个标记。
  # 输出一行结果，方便调用方（磁贴、Tasker）直接展示。
  toggle)
    acquire_service_lock || exit 1; trap cleanup_lifecycle EXIT INT TERM HUP
    if pid=$(running); then
      STOP_REQUEST_FILE="$RUN/.stop-request.$$"; : > "$STOP_REQUEST_FILE" 2>/dev/null
      stop
      rm -f "$STOP_REQUEST_FILE"; STOP_REQUEST_FILE=""
      sync_status
      echo "stopped"
      exit 0
    fi
    start
    _rc=$?
    sync_status
    if [ "$_rc" = "0" ]; then echo "running"; else echo "failed"; fi
    exit $_rc
    ;;

  *)       echo "用法: $0 {start|stop|restart|status|toggle}"; exit 1 ;;
esac
