#!/system/bin/sh
# Magpie 模块配置。改完重启服务生效:
#   su -c "sh /data/adb/modules/magpie/scripts/magpie.service restart"

# 数据目录（二进制、日志、magpie 自身数据）
magpie_path="/data/adb/magpie"

# API 网关监听地址。127.0.0.1 只监听本机；要开放给局域网改成 0.0.0.0:3425
MAGPIE_ADDR="127.0.0.1:3425"

# WebUI 监听地址。留空则自动用 MAGPIE_ADDR 的 host + 3430
MAGPIE_WEB_ADDR="127.0.0.1:3430"

# 上游 DNS（空格分隔）。Go 在 Android 上没有 /etc/resolv.conf 会退回 ::1:53，
# 这里用 DNS_LOCAL_HOSTNAMES 直连公网 DNS，不监听本地端口，不会与系统热点抢 53
MAGPIE_DNS="223.5.5.5 119.29.29.29 8.8.8.8"
