<?xml version="1.0" encoding="utf-8"?>
<!--
  磁贴伴侣 App：com.ruin.magpie.tile

  它不是 magpie 本体，也不做代理：只负责把「启动/停止 magpie 服务」这件事
  放进控制中心。真正的启停由模块里的 scripts/magpie.service toggle 完成，
  App 只通过 su 调它。

  minSdk 29：Tile.setSubtitle 需要 Q；再往下要写一堆兼容分支，
  而这个模块本身就只支持 arm64 + 现代系统，没必要。
  targetSdk 37：跟着最新版走，Android 17 上也不会因为「应用过旧」被限制。
  注意 37 只是 manifest 里的一个数字，编译仍用 android-34 的 jar ——
  本 App 没用到 35+ 的新接口，不需要更高的 compileSdk。
  targetSdk 35+ 会强制 edge-to-edge，界面那边已经做了 insets 适配。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ruin.magpie.tile"
    android:versionCode="15"
    android:versionName="1.3.1">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="37" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!--
          桌面入口放在一个 activity-alias 上，而不是 MainActivity 本身。
          这样「隐藏桌面图标」只要 setComponentEnabledSetting 关掉这个 alias：
          图标消失，但 MainActivity 仍然可以被显式启动
          （磁贴长按、adb、其他 App 拉起都行），不会把自己锁死。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <!--
              磁贴长按时，SystemUI 会发 ACTION_QS_TILE_PREFERENCES 到磁贴所在包。
              接住它就能打开设置页 —— 这是「隐藏桌面图标」之后的主要恢复入口。
              TileService 本身没有 onLongClick（android-34 的 API 里只有
              onClick / onStartListening / onStopListening），长按走的是这条 Intent。
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
          icon / label 不在这里重复声明：alias 会继承 targetActivity 的。
          重复声明只会让「改一个忘另一个」变成可能（图标对、名字错）。
        -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          磁贴服务。
          BIND_QUICK_SETTINGS_TILE 是系统要求：只有 SystemUI 能绑定它。
          exported=true 是必须的，否则 SystemUI 绑不上。
          这里不声明 TOGGLEABLE_TILE / ACTIVE_TILE：
          magpie 启停要几秒，做成「下拉栏直接点」会让用户误以为没反应。
        -->
        <service
            android:name=".MagpieTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
